{
  "name": "corta-fechas",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Corta Fecha - Automatización del Control de Productos Próximos a Vencer y Averiados",
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-catalog": "tsx prisma/import-catalog.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
